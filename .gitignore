# ============================================================
# .gitignore - OJ在线判题系统
# 注意：本项目将公开，请勿提交任何敏感信息（密码、密钥等）
# ============================================================

# ==================== Java 编译产物 ====================
*.class
*.jar
*.war
*.nar
*.ear
*.zip
*.tar.gz
*.rar

# ==================== Maven ====================
target/
pom.xml.tag
pom.xml.releaseBackup
pom.xml.versionsBackup
pom.xml.next
release.properties
dependency-reduced-pom.xml
buildNumber.properties
.mvn/timing.properties
.mvn/wrapper/maven-wrapper.jar

# ==================== Gradle ====================
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# ==================== Spring Boot ====================
*.pid

# ==================== Node.js / Vue 前端 ====================
# 依赖目录
node_modules/
.pnp
.pnp.js

# 测试覆盖率
coverage/

# 构建产物
dist/

# npm/yarn/pnpm 调试日志
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# ==================== 敏感配置文件（公开仓库必须忽略）====================
# 主配置文件（含数据库密码、Redis密码、微信密钥、COS密钥）
application.yml
# 生产/测试环境配置（含真实密码）
application-prod.yml
application-test.yml
# 环境变量文件
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
# 密钥证书
*.pem
*.key
*.crt
*.p12
*.jks

# ==================== IDE 编辑器 ====================
# IntelliJ IDEA
.idea/
*.iml
*.iws
*.ipr
out/

# VS Code
.vscode/

# Eclipse
.settings/
.classpath
.project
.metadata/

# ==================== 操作系统生成文件 ====================
# macOS
.DS_Store
.AppleDouble
.LSOverride
._*

# Windows
Thumbs.db
ehthumbs.db
Desktop.ini

# Linux
*~

# ==================== 日志与临时文件 ====================
logs/
*.log
*.tmp
*.temp

# ==================== AI 工具 ====================
.claude/
.windsurf/
.playwright-mcp/

# ==================== 项目特定目录 ====================
# 开发流程文档（内部文档，不公开）
开发流程/

# 文档目录（内部文档）
docs/
# 论文图表
diagrams/
# 论文资料
论文/
# 脚本目录（辅助脚本，无需提交）
scripts/

# 代码沙箱临时执行目录
tmpCode/

# ==================== 备份与快捷方式 ====================
*.lnk
*.bkp

# ==================== 大文件（避免仓库膨胀）====================
*.doc
*.docx
*.pdf
*.xlsx
*.xls

# ==================== 论文与测试相关（不公开）====================
# Word 临时文件
~$*
# 论文和测试文本提取
thesis_content.txt
test_content.txt
# 辅助脚本
check_*.py
fix_question18.sql